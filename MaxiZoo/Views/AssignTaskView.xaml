<UserControl x:Class="MaxiZoo.Views.AssignTaskView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="30">
            <Button Content="Tilbage"
                    Command="{Binding NavigateBackCommand}"
                    Width="64"
                    Margin="0,0,120,10"/>

            <TextBlock Text="Tildel opgave"
FontSize="28"
FontWeight="Bold"
Margin="0,0,0,20"/>

            <TextBlock Text="Vælg opgave"/>
            <ListBox ItemsSource="{Binding AvailableTasks}"
SelectedItem="{Binding SelectedTask}"
DisplayMemberPath="Title"
Height="150"
Margin="0,0,0,20"/>

            <StackPanel Margin="0,10,0,20">
                <TextBlock Text="Opgavedetaljer"
FontWeight="Bold"
FontSize="16"
Margin="0,0,0,10"/>

                <TextBlock Text="Titel:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Title}" Margin="0,0,0,5"/>

                <TextBlock Text="Beskrivelse:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Description}" Margin="0,0,0,5"/>

                <TextBlock Text="Deadline:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Deadline, StringFormat='{}{0:dd-MM-yyyy}'}" Margin="0,0,0,5"/>

                <TextBlock Text="Kategori:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Category}" Margin="0,0,0,5"/>

                <TextBlock Text="Prioritet:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Priority}" Margin="0,0,0,5"/>

                <TextBlock Text="Status:" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedTask.Status}" Margin="0,0,0,5"/>
            </StackPanel>

            <TextBlock Text="Vælg medarbejder"/>
            <ComboBox ItemsSource="{Binding Employees}"
SelectedItem="{Binding SelectedEmployee}"

DisplayMemberPath="Name"
Margin="0,0,0,20"/>

            <Button Content="Tildel opgave"
Command="{Binding AssignTaskCommand}"
Width="160"
Height="35"/>

        </StackPanel>
        
    </ScrollViewer>
</UserControl>
