<UserControl x:Class="MaxiZoo.Views.ManagerHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">
        <TextBlock Text="Chef/Souschef side" FontSize="20" Margin="0,0,0,20"/>
        
        <Button Content="Opret opgave" 
                Margin="0,0,0,10"
                Command="{Binding NavigateToCreateTaskCommand}"/>
        
        <Button Content="Overblik over alle opgaver" Margin="0,0,0,10"/>
        
        <Button Content="Tildel opgave" 
                Margin="0,0,0,10"
                Command="{Binding NavigateToAssignTaskCommand}"/>
        
        <Button Content="Godkend opgave" 
                Margin="0,0,0,10"
                Command="{Binding NavigateToApproveTaskCommand}"/>
        
        <Button Content="Opret medarbejder" 
                Margin="0,0,0,10"
                Command="{Binding NavigateToCreateEmployeeCommand}"/>
        
        <Button Content="Gendan opgave" Margin="0,0,0,10"/>
        
    </StackPanel>
</UserControl>
