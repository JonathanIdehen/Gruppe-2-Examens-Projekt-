<UserControl x:Class="MaxiZoo.Views.CreateEmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Navn:" FontSize="24"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirstName}" FontSize="20"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Efternavn:" FontSize="24" Margin="0,20,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastName}" FontSize="20" Margin="0,20,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="ID:" FontSize="24" Margin="0,20,0,0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmployeeIdInput}" FontSize="20" Margin="0,20,0,0"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stilling:" FontSize="24" Margin="0,20,0,0"/>
            <ComboBox Grid.Row="3" Grid.Column="1"
              ItemsSource="{Binding Roles}"
              SelectedItem="{Binding SelectedRole}"
              FontSize="20"
              Margin="0,20,0,0"/>

            <Button Grid.Row="4" Grid.Column="0"
            Content="Gem"
            Command="{Binding CreateEmployeeCommand}"
            FontSize="24"
            Width="120"
            Height="50"
            Margin="0,60,0,0"/>

            <Button Content="Tilbage"
        Command="{Binding NavigateBackCommand}"
        Width="120"
        Height="50" Grid.Column="1" Margin="410,80,-280,-20" Grid.Row="4"/>
        </Grid>
    </Grid>
</UserControl>
