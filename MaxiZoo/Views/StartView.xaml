<UserControl x:Class="MaxiZoo.Views.StartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">

        <TextBlock
            Text="Regstrer bruger ID"
            Margin="0,0,0,10"/>

        <TextBox
            Text="{Binding EmployeeIdInput, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,10"/>

        <Button
            Content="Fortsæt"
            Command="{Binding IdentifyUserCommand}"
            Width="120"/>

    </StackPanel>

</UserControl>
