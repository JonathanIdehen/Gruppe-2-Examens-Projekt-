<UserControl x:Class="MaxiZoo.Views.EmployeeHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">
        <TextBlock Text="Medarbejder side" FontSize="20" Margin="0,0,0,20"/>

        <Button Content="Mine opgaver" 
                Command="{Binding NavigateToMyTasksCommand}"
                Margin="0,0,0,10"/>

        <Button Content="Overblik over alle opgaver" Margin="0,0,0,10"
                Command="{Binding NavigateToTaskOverviewCommand}"/>

        <Button Content="Tilbage"
                Command="{Binding NavigateBackCommand}"
                Width="55"
                Height="20"/>

    </StackPanel>
</UserControl>
