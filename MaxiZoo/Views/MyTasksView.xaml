<UserControl x:Class="MaxiZoo.Views.MyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MaxiZoo.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
            ItemsSource="{Binding MyTasks}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Margin="20">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Opgave"
                            Binding="{Binding Title}"  
                            IsReadOnly="True"
                            Width="*" />

                <DataGridTemplateColumn Header="Status" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Gem">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Gem"
                            Command="{Binding DataContext.UpdateTaskStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Tilbage"
        Command="{Binding NavigateBackCommand}"
        Width="120"
        Margin="5,10,0,10"
        HorizontalAlignment="Left"
        Grid.Row="1"/>
    </Grid>
</UserControl>
