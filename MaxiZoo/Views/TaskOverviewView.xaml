<UserControl x:Class="MaxiZoo.Views.TaskOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      Width="150"
                      Margin="0,0,20,0"/>

            <TextBlock Text="Kategori:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      Width="180"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding FilteredTasks}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Prioritet" Binding="{Binding Priority}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150"/>
                <DataGridTextColumn Header="Medarbejder ID" Binding="{Binding EmployeeID}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Tilbage"
                Command="{Binding NavigateBackCommand}"
                Width="120"
                Margin="0,10,0,0"/>
    </Grid>
</UserControl>
