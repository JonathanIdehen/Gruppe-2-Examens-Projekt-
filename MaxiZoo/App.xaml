<Application x:Class="MaxiZoo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:MaxiZoo.ViewModels"
             xmlns:views="clr-namespace:MaxiZoo.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModels:StartViewModel}">
            <views:StartView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ManagerHomeViewModel}">
            <views:ManagerHomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:EmployeeHomeViewModel}">
            <views:EmployeeHomeView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:CreateTaskViewModel}">
            <views:CreateTaskView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:AssignTaskViewModel}">
            <views:AssignTaskView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CreateEmployeeViewModel}">
            <views:CreateEmployeeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:MyTasksViewModel}">
            <views:MyTasksView />
        </DataTemplate>

    </Application.Resources>
</Application>
